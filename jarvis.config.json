{
  "version": "2.3.1",
  "projectRoot": "/home/admin/galakrond",
  "projectShare": "\\\\wsl.localhost\\Debian\\home\\admin\\galakrond",
  "gitPull": {
    "enabled": true,
    "repos": [
      "/home/admin/galakrond",
      "/home/admin/galakrond/afkah",
      "/home/admin/galakrond/alexstrasza",
      "/home/admin/galakrond/eudora",
      "/home/admin/galakrond/onyxia",
      "/home/admin/galakrond/xyrella",
      "/home/admin/galakrond/sylvanas",
      "/home/admin/galakrond/tess"
    ]
  },
  "chrome": {
    "userDataDir": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
    "profileDir": "Profile 10",
    "debugPort": 9222,
    "extraUrls": [
      "https://mail.google.com/",
      "https://bo.fitdesk.io/",
      "https://dreamteamfitdesk.atlassian.net/jira/software/projects/FC/boards/34",
      "http://localhost:1080/"
    ]
  },
  "dockerPhases": [
    {
      "name": "infrastructure",
      "parallel": true,
      "services": [
        { "name": "afkah",       "path": "/home/admin/galakrond/afkah",       "command": "make dev-up", "network": "afkah"       },
        { "name": "alexstrasza", "path": "/home/admin/galakrond/alexstrasza", "command": "make dev-up", "network": "alexstrasza" },
        { "name": "punjabi",     "path": "/home/admin/punjabi",               "command": "make start",  "network": null, "optional": true }
      ]
    },
    {
      "name": "mail",
      "parallel": false,
      "optional": true,
      "waitHealthy": ["afkah", "alexstrasza"],
      "healthTimeoutSeconds": 60,
      "services": [
        { "name": "eudora", "path": "/home/admin/galakrond/eudora", "command": "docker compose up eudora-dev eudora-worker -d", "network": null }
      ]
    },
    {
      "name": "api",
      "parallel": false,
      "optional": true,
      "services": [
        { "name": "onyxia", "path": "/home/admin/galakrond/onyxia", "command": "make dev-up", "network": null }
      ]
    },
    {
      "name": "frontends",
      "parallel": true,
      "optional": true,
      "services": [
        { "name": "xyrella",  "path": "/home/admin/galakrond/xyrella",  "command": "make dev-up", "network": null },
        { "name": "sylvanas", "path": "/home/admin/galakrond/sylvanas", "command": "make dev-up", "network": null },
        { "name": "tess",     "path": "/home/admin/galakrond/tess",     "command": "make dev-up", "network": null }
      ]
    }
  ],
  "services": [
    { "name": "api",        "port": 3000, "url": null,                    "healthUrl": "http://localhost:3000/graphql", "dockerService": "onyxia"   },
    { "name": "backoffice", "port": 5174, "url": "http://localhost:5174/","healthUrl": "http://localhost:5174/",         "dockerService": "sylvanas" },
    { "name": "frontoffice","port": 5173, "url": "http://localhost:5173/","healthUrl": "http://localhost:5173/",         "dockerService": "tess"     },
    { "name": "showcase",   "port": 5175, "url": "http://localhost:5175/","healthUrl": "http://localhost:5175/",         "dockerService": "xyrella"  },
    { "name": "mongo",       "port": 27017, "url": null,                     "healthUrl": null,                    "dockerService": "afkah"       },
    { "name": "redis",       "port": 6379,  "url": null,                     "healthUrl": null,                    "dockerService": "alexstrasza" },
    { "name": "mailcatcher", "port": 1080,  "url": "http://localhost:1080/", "healthUrl": "http://localhost:1080/","dockerService": "punjabi"     },
    { "name": "eudora",      "port": 8025,  "url": null,                     "healthUrl": "http://localhost:8025/","dockerService": "eudora" }
  ],
  "terminalTabs": [
    { "title": "Claude",     "command": "claude" },
    { "title": "Galakrond",  "command": "" }
  ],
  "paths": {
    "compass": "%LOCALAPPDATA%\\MongoDBCompass\\MongoDBCompass.exe",
    "vscode": "code"
  }
}
